<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Extra carry capacity</li>
			<li>ExtraCapacity</li>
			<li>true</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.Conditional">
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[key="ExtraCapacityHuman"]</xpath>
		<caseFalse>
			<Operation Class="XmlExtensions.PatchOperationInsert">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_ExtraCapacity"]</xpath>
				<value>
					<li Class="XmlExtensions.Setting.Text">
						<text>Adds a percentage of each pawn's base capacity (body size x 35 kg) on top of everything else, including implant bonuses. Humans and animals each have their own percentage. Animals only get it if they are pack animals (vanilla, or made pack animals by a mod such as Caravan Packs). Babies are not affected.</text>
					</li>
					<li Class="XmlExtensions.Setting.Gap">
						<spacing>12</spacing>
					</li>
					<li Class="XmlExtensions.Setting.Numeric">
						<decimals>1</decimals>
						<percent>true</percent>
						<key>ExtraCapacityHuman</key>
						<label>Humans</label>
						<defaultValue>0</defaultValue>
						<tooltip>Extra carry capacity for humans and other humanlike pawns, as a percentage of their base capacity.</tooltip>
					</li>
					<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_CapacityExamples">
						<percentKey>ExtraCapacityHuman</percentKey>
						<races>
							<li>Human</li>
						</races>
					</li>
					<li Class="XmlExtensions.Setting.Gap">
						<spacing>12</spacing>
					</li>
					<li Class="XmlExtensions.Setting.Numeric">
						<decimals>1</decimals>
						<percent>true</percent>
						<key>ExtraCapacityAnimal</key>
						<label>Animals</label>
						<defaultValue>0</defaultValue>
						<tooltip>Extra carry capacity for pack animals, as a percentage of their base capacity.</tooltip>
					</li>
					<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_CapacityExamples">
						<percentKey>ExtraCapacityAnimal</percentKey>
						<races>
							<li>Husky</li>
							<li>Muffalo</li>
							<li>Thrumbo</li>
						</races>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSectionExtraCapacity"]/actions/li/keys</xpath>
				<value>
					<li>ExtraCapacityHuman</li>
					<li>ExtraCapacityAnimal</li>
				</value>
			</Operation>
		</caseFalse>
	</Operation>
</Patch>
