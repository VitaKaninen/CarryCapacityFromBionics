<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="XmlExtensions.Conditional">
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[key="ExtraCapacityAnimal"]</xpath>
		<caseFalse>
			<Operation Class="XmlExtensions.PatchOperationReplace">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_ExtraHumanRow"]/leftCol/li/tooltip</xpath>
				<value>
					<tooltip>Optional. Adds a percentage of each humanlike pawn's base capacity (body size x 35 kg) on top of everything else, in both easy and advanced mode. Babies are not affected.</tooltip>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationInsert">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_ExtraHumanRow"]</xpath>
				<order>Append</order>
				<value>
					<li Class="XmlExtensions.Setting.SplitColumn">
						<split>0.79</split>
						<anchor>Middle</anchor>
						<leftCol>
							<li Class="XmlExtensions.Setting.Text">
								<text>Extra capacity for pack animals</text>
								<anchor>Right</anchor>
								<tooltip>Optional. Adds a percentage of each pack animal's base capacity (body size x 35 kg). Animals only get it if they are pack animals (vanilla, or made pack animals by a mod such as Caravan Packs). Babies are not affected.</tooltip>
							</li>
						</leftCol>
						<rightCol>
							<li Class="XmlExtensions.Setting.Numeric">
								<decimals>1</decimals>
								<percent>true</percent>
								<key>ExtraCapacityAnimal</key>
								<defaultValue>0</defaultValue>
							</li>
						</rightCol>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationInsert">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_ExtraHumanExamples"]</xpath>
				<order>Append</order>
				<value>
					<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_CapacityExamples">
						<percentKey>ExtraCapacityAnimal</percentKey>
						<examples>
							<li>
								<race>Husky</race>
							</li>
							<li>
								<race>Muffalo</race>
							</li>
							<li>
								<race>Thrumbo</race>
							</li>
						</examples>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSectionSimple"]/actions/li/keys</xpath>
				<value>
					<li>ExtraCapacityAnimal</li>
				</value>
			</Operation>
		</caseFalse>
	</Operation>
</Patch>
