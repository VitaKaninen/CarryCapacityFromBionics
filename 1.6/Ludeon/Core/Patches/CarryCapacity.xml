<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Generated-style implant list. To add an implant: add its defName to the CreateDocument
		xpath below AND add one ApplyPatch block. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Menu</docName>
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]</xpath>
	</Operation>
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Hediffs</docName>
		<xpath>Defs/HediffDef[defName="SimpleProstheticArm" or defName="SimpleProstheticLeg" or defName="WoodenHand" or defName="WoodenFoot" or defName="PegLeg" or defName="PowerClaw" or defName="BionicArm" or defName="BionicLeg" or defName="ArchotechArm" or defName="ArchotechLeg" or defName="BionicSpine"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Core Implants</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>SimpleProstheticArm</li>
			<li>SimpleProstheticArm</li>
			<li>Prosthetic Arm</li>
			<li>false</li>
			<li>-5</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>SimpleProstheticLeg</li>
			<li>SimpleProstheticLeg</li>
			<li>Prosthetic Leg</li>
			<li>false</li>
			<li>-7.5</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>WoodenHand</li>
			<li>WoodenHand</li>
			<li>Wooden Hand</li>
			<li>false</li>
			<li>-2</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>WoodenFoot</li>
			<li>WoodenFoot</li>
			<li>Wooden Foot</li>
			<li>false</li>
			<li>-5</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>PegLeg</li>
			<li>PegLeg</li>
			<li>Peg Leg</li>
			<li>false</li>
			<li>-10</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>PowerClaw</li>
			<li>PowerClaw</li>
			<li>Power Claw</li>
			<li>false</li>
			<li>0</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>BionicArm</li>
			<li>BionicArm</li>
			<li>Bionic Arm</li>
			<li>true</li>
			<li>12.5</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>BionicLeg</li>
			<li>BionicLeg</li>
			<li>Bionic Leg</li>
			<li>true</li>
			<li>22.5</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechArm</li>
			<li>ArchotechArm</li>
			<li>Archotech Arm</li>
			<li>true</li>
			<li>25</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechLeg</li>
			<li>ArchotechLeg</li>
			<li>Archotech Leg</li>
			<li>true</li>
			<li>40</li>
			<li>Core</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>BionicSpine</li>
			<li>BionicSpine</li>
			<li>Bionic Spine</li>
			<li>true</li>
			<li>20</li>
			<li>Core</li>
		</arguments>
	</Operation>

	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Hediffs</docName>
	</Operation>
	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Menu</docName>
	</Operation>
</Patch>
