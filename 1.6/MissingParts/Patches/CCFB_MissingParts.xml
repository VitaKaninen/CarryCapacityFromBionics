<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Missing body part penalty - settings section. These rows feed the C# half
		(CarryCapacityMissingParts.dll in Common/Assemblies); they do NOT patch any defs.
		The DLL reads the values once at startup via XmlExtensions.SettingsManager and only
		acts when the section's master checkbox (ToggleSectionMissingParts, created by
		CCFB_Section, default OFF) is ticked. Defaults here MUST stay in sync with the
		compiled defaults in MissingPartsBootstrap.cs. Values are NEGATIVE (they remove
		carry capacity); kg = -(roadmap weight % x 35); the C# uses the absolute value.
		Row args for CCFB_PartRow: key | label | toggle default | kg default | section tag.
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Missing body parts</li>
			<li>MissingParts</li>
			<li>false</li>
		</arguments>
	</Operation>

	<!-- First row: the floor - penalties never reduce a pawn below this capacity.
	     Added directly (no checkbox, not worth a PatchDef); guarded on its own key. -->
	<Operation Class="XmlExtensions.Conditional">
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[key="MissingPartFloor"]</xpath>
		<caseFalse>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_MissingParts"]/leftCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.Text">
						<text>Minimum carry capacity (hover for details)</text>
						<tooltip>Penalties never reduce a pawn below this many kg. At 0, a badly mangled pawn can carry nothing in inventory but still wears gear, wields weapons and eats normally. Raise it (e.g. 10) if you do not want crippled pawns to weigh down caravans. Missing parts subtract their full value, damaged parts a fraction scaled by lost HP; per limb, damage is never penalized worse than amputation; bionics and prosthetics count as present.</tooltip>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_MissingParts"]/rightCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.Numeric">
						<decimals>2</decimals>
						<padLeft>85</padLeft>
						<key>MissingPartFloor</key>
						<label>Minimum capacity in kg</label>
						<defaultValue>0</defaultValue>
					</li>
				</value>
			</Operation>
		</caseFalse>
	</Operation>

	<!-- Per-part rows, large to small (roadmap weight table; kg = -(% x 35)) -->
