<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Missing body part penalty - settings section. These rows feed the C# half
		(CarryCapacityMissingParts.dll in Common/Assemblies); they do NOT patch any defs.
		The DLL reads the values once at startup via XmlExtensions.SettingsManager and only
		acts when the master toggle is on. Defaults here MUST stay in sync with the compiled
		defaults in MissingPartsBootstrap.cs (kg = roadmap weight % x 35).
		Row args for CCFB_PartRow: key | label | toggle default | kg default | section tag.
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Missing body parts</li>
			<li>MissingParts</li>
		</arguments>
	</Operation>

	<!-- Intro text + master toggle row (checkbox left, minimum-capacity field right).
	     Added directly (one-off layout, not worth a PatchDef). Idempotence comes from the
	     same key-exists guard CCFB_PartRow uses. -->
	<Operation Class="XmlExtensions.Conditional">
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="ToggleMissingPartPenalty"]</xpath>
		<caseFalse>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings/li/settings/li[tag="CCFB_MissingParts"]/leftCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.SplitColumn">
						<width>24</width>
						<gapSize>6</gapSize>
						<anchor>Middle</anchor>
						<leftCol>
							<li Class="XmlExtensions.Setting.Checkbox">
								<label></label>
								<key>ToggleMissingPartPenalty</key>
								<defaultValue>false</defaultValue>
							</li>
						</leftCol>
						<rightCol>
							<li Class="XmlExtensions.Setting.Text">
								<text>Enable missing body part penalties (hover for details)</text>
								<tooltip>Missing parts subtract their full value; damaged parts subtract a fraction scaled by lost HP. Per limb, a damaged limb is never penalized worse than its amputation. Bionics and prosthetics count as present. The minimum field stops penalties from dropping a pawn below that capacity.</tooltip>
							</li>
						</rightCol>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings/li/settings/li[tag="CCFB_MissingParts"]/rightCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.ToggleableSettings">
						<key>ToggleMissingPartPenalty</key>
						<caseTrue>
							<li Class="XmlExtensions.Setting.Numeric">
								<decimals>2</decimals>
								<padLeft>85</padLeft>
								<key>MissingPartFloor</key>
								<label>Minimum carry capacity in kg</label>
								<defaultValue>0</defaultValue>
							</li>
						</caseTrue>
						<caseFalse>
							<li Class="XmlExtensions.Setting.Text">
								<text>Disabled</text>
								<anchor>Right</anchor>
							</li>
						</caseFalse>
					</li>
				</value>
			</Operation>
		</caseFalse>
	</Operation>

	<!-- Per-part rows, large to small (roadmap weight table; kg = % x 35) -->
