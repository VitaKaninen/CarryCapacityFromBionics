<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		One ApplyPatch block per implant. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Advanced Archotech Arm</li>
			<li>AdvancedArchotechArm</li>
			<li>true</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>AdvancedArchotechObliterator</li>
			<li>AdvancedArchotechObliterator</li>
			<li>Adv. Archotech Obliterator</li>
			<li>true</li>
			<li>65</li>
			<li>AdvancedArchotechArm</li>
		</arguments>
	</Operation>
</Patch>
