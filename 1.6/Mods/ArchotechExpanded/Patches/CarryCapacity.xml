<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Generated-style implant list. To add an implant: add its defName to the CreateDocument
		xpath below AND add one ApplyPatch block. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Menu</docName>
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]</xpath>
	</Operation>
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Hediffs</docName>
		<xpath>Defs/HediffDef[defName="AdvancedArchotechArm" or defName="AdvancedArchotechLeg" or defName="ArchotechDeathClaw" or defName="ArchotechObliterator" or defName="ArchotechPelvis" or defName="ArchotechMembrane" or defName="ArchotechSpine"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Archotech Expanded</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>AdvancedArchotechArm</li>
			<li>AEAdvancedArchotechArm</li>
			<li>Advanced Archotech Arm</li>
			<li>true</li>
			<li>65</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>AdvancedArchotechLeg</li>
			<li>AEAdvancedArchotechLeg</li>
			<li>Advanced Archotech Leg</li>
			<li>true</li>
			<li>100</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechDeathClaw</li>
			<li>AEArchotechDeathClaw</li>
			<li>Archotech Death Claw</li>
			<li>true</li>
			<li>25</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechObliterator</li>
			<li>AEArchotechObliterator</li>
			<li>Archotech Obliterator</li>
			<li>true</li>
			<li>25</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechPelvis</li>
			<li>AEArchotechPelvis</li>
			<li>Archotech Pelvis</li>
			<li>true</li>
			<li>35</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechMembrane</li>
			<li>AEArchotechMembrane</li>
			<li>Archotech Membrane</li>
			<li>true</li>
			<li>35</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>ArchotechSpine</li>
			<li>AEArchotechSpine</li>
			<li>Archotech Spine</li>
			<li>true</li>
			<li>42</li>
			<li>ArchotechExpanded</li>
		</arguments>
	</Operation>

	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Hediffs</docName>
	</Operation>
	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Menu</docName>
	</Operation>
</Patch>
