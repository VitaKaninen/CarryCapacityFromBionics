<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Generated-style implant list. To add an implant: add its defName to the CreateDocument
		xpath below AND add one ApplyPatch block. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Menu</docName>
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]</xpath>
	</Operation>
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Hediffs</docName>
		<xpath>Defs/HediffDef[defName="SimpleProstheticHand" or defName="SimpleProstheticFoot" or defName="ArtificialPelvis" or defName="ArtificialClavicle" or defName="HookHand" or defName="SteelArm" or defName="BionicHand" or defName="BionicFoot" or defName="PowerArm" or defName="MuscleStimulatorArms" or defName="MuscleStimulatorLegs" or defName="AdvancedPowerArm" or defName="AdvancedPowerClaw" or defName="AdvancedBionicHand" or defName="AdvancedBionicFoot" or defName="AdvancedBionicArm" or defName="AdvancedBionicLeg" or defName="AdvancedBionicSpine" or defName="ExoskeletonSuit"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Expanded Prosthetics and Organ Engineering</li>
			<li>EPOE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
