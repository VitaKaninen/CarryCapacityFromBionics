<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Generated-style implant list. To add an implant: add its defName to the CreateDocument
		xpath below AND add one ApplyPatch block. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Menu</docName>
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]</xpath>
	</Operation>
	<Operation Class="XmlExtensions.CreateDocument">
		<docName>CCFB_Hediffs</docName>
		<xpath>Defs/HediffDef[defName="FSFBionicDrillArm" or defName="FSFBionicFieldArm" or defName="FSFAdvBionicFieldArm" or defName="FSFAdvBionicDrillArm"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>[FSF] Advanced Bionics Expansion</li>
			<li>FSFABE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFBionicDrillArm</li>
			<li>FSFBionicDrillArm</li>
			<li>Bionic Drill Arm</li>
			<li>true</li>
			<li>12.5</li>
			<li>FSFABE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFBionicFieldArm</li>
			<li>FSFBionicFieldArm</li>
			<li>Bionic Field Arm</li>
			<li>true</li>
			<li>12.5</li>
			<li>FSFABE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFAdvBionicFieldArm</li>
			<li>FSFAdvBionicFieldArm</li>
			<li>Adv. Bionic Field Arm</li>
			<li>true</li>
			<li>25</li>
			<li>FSFABE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFAdvBionicDrillArm</li>
			<li>FSFAdvBionicDrillArm</li>
			<li>Adv. Bionic Drill Arm</li>
			<li>true</li>
			<li>25</li>
			<li>FSFABE</li>
		</arguments>
	</Operation>

	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Hediffs</docName>
	</Operation>
	<Operation Class="XmlExtensions.MergeDocument">
		<docName>CCFB_Menu</docName>
	</Operation>
</Patch>
