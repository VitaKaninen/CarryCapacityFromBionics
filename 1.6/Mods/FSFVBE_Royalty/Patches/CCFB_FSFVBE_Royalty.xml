<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		One ApplyPatch block per implant. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>[FSF] Vanilla Bionics Expansion</li>
			<li>FSFVBE</li>
			<li>true</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFBionicDrillArm</li>
			<li>FSFBionicDrillArm</li>
			<li>Bionic Drill Arm</li>
			<li>true</li>
			<li>12.5</li>
			<li>FSFVBE</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>FSFBionicFieldArm</li>
			<li>FSFBionicFieldArm</li>
			<li>Bionic Field Arm</li>
			<li>true</li>
			<li>12.5</li>
			<li>FSFVBE</li>
		</arguments>
	</Operation>
</Patch>
