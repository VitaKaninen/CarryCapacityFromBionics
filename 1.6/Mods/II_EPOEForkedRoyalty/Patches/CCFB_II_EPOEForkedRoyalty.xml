<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		One ApplyPatch block per implant. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
		Left/right pairs share one key, so the menu shows a single row for both sides.
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Integrated Implants</li>
			<li>II</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>LeftExtraAdvancedDrillArm</li>
			<li>IIExtraAdvancedDrillArm</li>
			<li>Extra Adv. Drill Arm (EPOE)</li>
			<li>false</li>
			<li>0</li>
			<li>II</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>RightExtraAdvancedDrillArm</li>
			<li>IIExtraAdvancedDrillArm</li>
			<li>Extra Adv. Drill Arm (EPOE)</li>
			<li>false</li>
			<li>0</li>
			<li>II</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>LeftExtraAdvancedFieldHand</li>
			<li>IIExtraAdvancedFieldHand</li>
			<li>Extra Adv. Field Hand (EPOE)</li>
			<li>false</li>
			<li>0</li>
			<li>II</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>RightExtraAdvancedFieldHand</li>
			<li>IIExtraAdvancedFieldHand</li>
			<li>Extra Adv. Field Hand (EPOE)</li>
			<li>false</li>
			<li>0</li>
			<li>II</li>
		</arguments>
	</Operation>
</Patch>
