<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Native-VEF catch-up, Anomaly part (HulkificationSurgery lives in Integrated Implants'
		Anomaly-gated folder). See CCFB_II_NoVEF.xml for the full explanation.
		Arguments: defName | settings key | menu label | toggle default | kg default | section tag
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Integrated Implants</li>
			<li>II</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_ImplantStandaloneOnly</patchName>
		<arguments>
			<li>HulkificationSurgery</li>
			<li>IIHulkificationSurgery</li>
			<li>Hulkification</li>
			<li>true</li>
			<li>50</li>
			<li>II</li>
		</arguments>
	</Operation>
</Patch>
