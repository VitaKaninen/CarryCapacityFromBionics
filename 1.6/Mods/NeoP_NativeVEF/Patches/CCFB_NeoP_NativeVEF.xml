<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		Native-VEF override (see CCFB_ImplantNativeVEF in Common/Defs/PatchDefs.xml).
		These implants grant VEF_MassCarryCapacity natively. In VEF games the setting REPLACES the
		author's native value (toggle off = leave the author's value); without VEF we add our own
		CarryCapacityBonus instead. Defaults are the author's own values, so out of the box every
		player gets the author's bonus. The folder loads with or without VEF.
		Arguments: defName | settings key | menu label | toggle default | kg default | section tag
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>Neolithic Prosthetics</li>
			<li>NeoP</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_ImplantNativeVEF</patchName>
		<arguments>
			<li>MuffaloSpine</li>
			<li>NeoPMuffaloSpine</li>
			<li>Muffalo Spine</li>
			<li>true</li>
			<li>50</li>
			<li>NeoP</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_ImplantNativeVEF</patchName>
		<arguments>
			<li>SyntheticMuffaloSpine</li>
			<li>NeoPSyntheticMuffaloSpine</li>
			<li>Synthetic Muffalo Spine</li>
			<li>true</li>
			<li>75</li>
			<li>NeoP</li>
		</arguments>
	</Operation>
</Patch>
