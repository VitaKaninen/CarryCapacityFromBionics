<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--
		One ApplyPatch block per implant. Arguments, in order:
		defName | settings key | menu label | toggle default | kg default | menu section tag
	-->
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Section</patchName>
		<arguments>
			<li>V.O.I.D</li>
			<li>VOID</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>RH2_VOIDArchotechArm</li>
			<li>RH2_VOIDArchotechArm</li>
			<li>Voidtech Arm</li>
			<li>true</li>
			<li>25</li>
			<li>VOID</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>RH2_VOIDArchotechLeg</li>
			<li>RH2_VOIDArchotechLeg</li>
			<li>Voidtech Leg</li>
			<li>true</li>
			<li>40</li>
			<li>VOID</li>
		</arguments>
	</Operation>
	<Operation Class="XmlExtensions.ApplyPatch">
		<patchName>CCFB_Implant</patchName>
		<arguments>
			<li>RH_VOIDBionicSpine</li>
			<li>RH_VOIDBionicSpine</li>
			<li>Voidtech Spine</li>
			<li>true</li>
			<li>20</li>
			<li>VOID</li>
		</arguments>
	</Operation>
</Patch>
