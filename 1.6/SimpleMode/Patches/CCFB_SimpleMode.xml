<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="Vita.CarryCapacityFromBionics.MissingParts.PatchOperation_DecideMode"/>
	<Operation Class="XmlExtensions.PatchOperationAdd">
		<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings</xpath>
		<value>
			<li Class="XmlExtensions.Setting.Gap">
				<spacing>12</spacing>
			</li>
			<li Class="XmlExtensions.Setting.Section">
				<tag>CCFB_MainBox</tag>
				<settings>
					<li Class="XmlExtensions.Setting.Text">
						<text>Carry capacity settings</text>
						<font>Medium</font>
						<anchor>Middle</anchor>
					</li>
					<li Class="XmlExtensions.Setting.GapLine"/>
					<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_ModeChoice">
						<key>ToggleSectionSimple</key>
						<defaultValue>true</defaultValue>
						<options>
							<li>
								<value>true</value>
								<label>Easy settings</label>
								<description>Every implant gets its recommended carry bonus. Change them all at once with one percentage.</description>
							</li>
							<li>
								<value>false</value>
								<label>Advanced settings</label>
								<description>Turn each implant on or off and set its own bonus, in a section per mod below.</description>
							</li>
						</options>
					</li>
					<li Class="XmlExtensions.Setting.GapLine"/>
					<li Class="XmlExtensions.Setting.ToggleableSettings">
						<key>ToggleSectionSimple</key>
						<caseTrue>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<anchor>Top</anchor>
								<gapSize>24</gapSize>
								<leftCol>
									<li Class="XmlExtensions.Setting.Group">
										<tag>CCFB_ScaleRow</tag>
										<settings>
											<li Class="XmlExtensions.Setting.SplitColumn">
												<split>0.79</split>
												<anchor>Middle</anchor>
												<leftCol>
													<li Class="XmlExtensions.Setting.Text">
														<text>Scale implant values by</text>
													</li>
												</leftCol>
												<rightCol>
													<li Class="XmlExtensions.Setting.Numeric">
														<decimals>1</decimals>
														<percent>true</percent>
														<key>SimpleScale</key>
														<defaultValue>100</defaultValue>
													</li>
												</rightCol>
											</li>
											<li Class="XmlExtensions.Setting.Text">
												<text>&lt;color=#9a9a9a&gt;Multiplies every implant bonus. 100% = recommended values, 200% = double.&lt;/color&gt;</text>
												<font>Tiny</font>
												<padBelow>6</padBelow>
											</li>
										</settings>
									</li>
									<li Class="XmlExtensions.Setting.Group">
										<settings>
											<li Class="XmlExtensions.Setting.SplitColumn">
												<split>0.79</split>
												<anchor>Middle</anchor>
												<leftCol>
													<li Class="XmlExtensions.Setting.Text">
														<text>Include prosthetic penalties</text>
													</li>
												</leftCol>
												<rightCol>
													<li Class="XmlExtensions.Setting.Checkbox">
														<label></label>
														<key>SimplePenalties</key>
														<defaultValue>false</defaultValue>
														<padRight>25</padRight>
													</li>
												</rightCol>
											</li>
											<li Class="XmlExtensions.Setting.Text">
												<text>&lt;color=#9a9a9a&gt;Prosthetics weaker than a natural limb (prosthetic, wooden, peg) lower carry capacity.&lt;/color&gt;</text>
												<font>Tiny</font>
												<padBelow>6</padBelow>
											</li>
										</settings>
									</li>
									<li Class="XmlExtensions.Setting.Group">
										<settings>
											<li Class="XmlExtensions.Setting.SplitColumn">
												<split>0.79</split>
												<anchor>Middle</anchor>
												<leftCol>
													<li Class="XmlExtensions.Setting.Text">
														<text>Include missing body part penalties</text>
													</li>
												</leftCol>
												<rightCol>
													<li Class="XmlExtensions.Setting.Checkbox">
														<label></label>
														<key>ToggleSectionMissingParts</key>
														<defaultValue>false</defaultValue>
														<padRight>25</padRight>
													</li>
												</rightCol>
											</li>
											<li Class="XmlExtensions.Setting.Text">
												<text>&lt;color=#9a9a9a&gt;Missing or damaged limbs, spine and pelvis lower carry capacity.&lt;/color&gt;</text>
												<font>Tiny</font>
												<padBelow>6</padBelow>
											</li>
										</settings>
									</li>
								</leftCol>
								<rightCol>
									<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_SimpleExamples">
										<tag>CCFB_SimpleExamples</tag>
										<header>Implant examples (hover for details):</header>
										<padBelow>6</padBelow>
										<rows/>
										<groups>
											<li>
												<label>Vanilla</label>
												<section>Core</section>
												<featured>
													<li>BionicArm</li>
													<li>ArchotechLeg</li>
													<li>BionicSpine</li>
												</featured>
												<penalties>
													<li>SimpleProstheticLeg</li>
												</penalties>
												<missingLeg>true</missingLeg>
											</li>
											<li>
												<label>Advanced Archotech Arm</label>
												<section>AdvancedArchotechArm</section>
												<featured>
													<li>AdvancedArchotechObliterator</li>
												</featured>
											</li>
											<li>
												<label>Archotech Expanded</label>
												<section>ArchotechExpanded</section>
												<featured>
													<li>AEAdvancedArchotechArm</li>
													<li>AEAdvancedArchotechLeg</li>
													<li>AEArchotechSpine</li>
												</featured>
											</li>
											<li>
												<label>Astraltech</label>
												<section>Astral</section>
												<featured>
													<li>AstralArm</li>
													<li>AstralLeg</li>
													<li>AstralSpine</li>
												</featured>
											</li>
											<li>
												<label>EPOE</label>
												<section>EPOE</section>
												<featured>
													<li>EPOEPowerArm</li>
													<li>EPOEAdvancedBionicLeg</li>
													<li>EPOEAdvancedBionicSpine</li>
												</featured>
											</li>
											<li>
												<label>EPOE-Forked</label>
												<section>EPOEForked</section>
												<featured>
													<li>EPOEPowerArm</li>
													<li>EPOEAdvancedBionicLeg</li>
													<li>EPOEAdvancedBionicSpine</li>
												</featured>
											</li>
											<li>
												<label>FSF Advanced Bionics</label>
												<section>FSFABE</section>
												<featured>
													<li>FSFAdvBionicArm</li>
													<li>FSFAdvBionicLeg</li>
													<li>FSFArchotechSpine</li>
												</featured>
											</li>
											<li>
												<label>FSF Vanilla Bionics</label>
												<section>FSFVBE</section>
												<featured>
													<li>FSFBionicPowerArm</li>
													<li>FSFArchotechSpine</li>
												</featured>
											</li>
											<li>
												<label>Integrated Implants</label>
												<section>II</section>
												<featured>
													<li>IIExtraArchotechArm</li>
													<li>IIStrengthEnhancer</li>
													<li>IILTS_ArchotechSpine</li>
													<li>IILTS_ModularArchotechSpine</li>
													<li>IISkeletalBracing</li>
												</featured>
											</li>
											<li>
												<label>Industrial Prosthetics</label>
												<section>IP</section>
												<featured>
													<li>IPPoweredArm</li>
													<li>IPPoweredLeg</li>
													<li>IPPoweredSpine</li>
												</featured>
											</li>
											<li>
												<label>Medieval Prosthetics</label>
												<section>MedP</section>
												<penalties>
													<li>MedPMechanicalLeg</li>
												</penalties>
											</li>
											<li>
												<label>Neolithic Prosthetics</label>
												<section>NeoP</section>
												<featured>
													<li>NeoPInsectoidLimbs</li>
													<li>NeoPSewnInBag</li>
													<li>NeoPMuffaloSpine</li>
												</featured>
												<penalties>
													<li>NeoPTotemicLeg</li>
												</penalties>
											</li>
											<li>
												<label>RBSE</label>
												<section>RBSE</section>
												<featured>
													<li>RBSEPowerArm</li>
													<li>RBSEAdvancedBionicLeg</li>
													<li>RBSEAdvancedBionicSpine</li>
												</featured>
											</li>
											<li>
												<label>Save Our Ship 2</label>
												<section>SoS2</section>
												<featured>
													<li>SoSPsychicManipulator</li>
													<li>SoSArchotechSpine</li>
												</featured>
											</li>
											<li>
												<label>V.O.I.D</label>
												<section>VOID</section>
												<featured>
													<li>RH2_VOIDArchotechArm</li>
													<li>RH2_VOIDArchotechLeg</li>
													<li>RH_VOIDBionicSpine</li>
												</featured>
											</li>
											<li>
												<label>YAPE</label>
												<section>YAPE</section>
												<featured>
													<li>YAPEAdvancedBionicArm</li>
													<li>YAPEUltratechBionicLeg</li>
													<li>YAPEUltratechBionicSpine</li>
												</featured>
											</li>
										</groups>
									</li>
								</rightCol>
							</li>
						</caseTrue>
						<caseFalse/>
					</li>
					<li Class="XmlExtensions.Setting.SplitColumn">
						<tag>CCFB_ExtraHumanRow</tag>
						<anchor>Top</anchor>
						<gapSize>24</gapSize>
						<leftCol>
							<li Class="XmlExtensions.Setting.Group">
								<settings>
									<li Class="XmlExtensions.Setting.SplitColumn">
										<split>0.79</split>
										<anchor>Middle</anchor>
										<leftCol>
											<li Class="XmlExtensions.Setting.Text">
												<text>Extra capacity for humans</text>
											</li>
										</leftCol>
										<rightCol>
											<li Class="XmlExtensions.Setting.Numeric">
												<decimals>1</decimals>
												<percent>true</percent>
												<key>ExtraCapacityHuman</key>
												<defaultValue>0</defaultValue>
											</li>
										</rightCol>
									</li>
									<li Class="XmlExtensions.Setting.Text">
										<tag>CCFB_ExtraHumanDesc</tag>
										<text>&lt;color=#9a9a9a&gt;Adds this share of every humanlike's base capacity (35 kg for an adult), on top of everything else. A Dog Said... Animal Prosthetics 2 adds a pack animal setting.&lt;/color&gt;</text>
										<font>Tiny</font>
										<padBelow>6</padBelow>
									</li>
								</settings>
							</li>
						</leftCol>
						<rightCol>
							<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_CapacityExamples">
								<tag>CCFB_ExtraHumanExamples</tag>
								<header>Extra capacity:</header>
								<percentKey>ExtraCapacityHuman</percentKey>
								<examples>
									<li>
										<label>Colonist</label>
										<race>Human</race>
									</li>
								</examples>
							</li>
						</rightCol>
					</li>
					<li Class="XmlExtensions.Setting.Gap">
						<spacing>12</spacing>
					</li>
					<li Class="XmlExtensions.Setting.Button">
						<label>Reset these settings</label>
						<key>ToggleSectionSimple</key>
						<height>24</height>
						<confirm>true</confirm>
						<message>Reset the settings in this box to their defaults (Easy settings)?</message>
						<tooltip>Resets the choices in this box, which also switches back to Easy settings. The per-mod sections are not touched.</tooltip>
						<actions>
							<li Class="XmlExtensions.Action.ResetSettings">
								<keys>
									<li>ToggleSectionSimple</li>
									<li>SimpleScale</li>
									<li>SimplePenalties</li>
									<li>ToggleSectionMissingParts</li>
									<li>ExtraCapacityHuman</li>
								</keys>
							</li>
						</actions>
					</li>
				</settings>
			</li>
		</value>
	</Operation>
</Patch>
