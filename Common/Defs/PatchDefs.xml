<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--
		CCFB_Section: creates one labeled section in the settings menu (title, then the rows'
		SplitColumn tagged CCFB_{section} and a "Reset this section" button), inside the
		advanced-mode container.
		Args (in order): section label | section tag.
		Idempotent: if a SplitColumn tagged CCFB_{section} already exists, does nothing, so any
		patch file may call it for the section it needs and patch-file order does not matter.
	-->
	<XmlExtensions.PatchDef Name="CCFB_Section" Abstract="True">
		<parameters>
			<li>sectionLabel</li>
			<li>section</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.ApplyPatch">
				<patchName>CCFB_AdvancedContainer</patchName>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings/li[tag="CCFB_AdvancedSections"]/caseFalse</xpath>
						<value>
							<li Class="XmlExtensions.Setting.Gap">
								<spacing>24</spacing>
							</li>
							<li Class="XmlExtensions.Setting.Text">
								<text>{sectionLabel}</text>
								<font>Medium</font>
								<anchor>Middle</anchor>
							</li>
							<li Class="XmlExtensions.Setting.GapLine"/>
							<li Class="XmlExtensions.Setting.Section">
								<settings>
									<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_SectionToggle">
										<tag>CCFB_{section}_All</tag>
										<tooltip>Turns every implant in this section on or off at once.</tooltip>
										<unit>kg</unit>
										<keys/>
									</li>
									<li Class="XmlExtensions.Setting.Gap">
										<spacing>6</spacing>
									</li>
									<li Class="XmlExtensions.Setting.SplitColumn">
										<tag>CCFB_{section}</tag>
										<leftCol/>
										<rightCol/>
									</li>
									<li Class="XmlExtensions.Setting.Gap">
										<spacing>12</spacing>
									</li>
									<!-- Per-section reset. Every row PatchDef registers its keys into this
									     button's ResetSettings list as it adds its row, so the button only
									     ever touches THIS section's settings. -->
									<li Class="XmlExtensions.Setting.Button">
										<label>Reset this section</label>
										<key>ToggleSection{section}</key>
										<height>24</height>
										<confirm>true</confirm>
										<message>Reset every setting in this section to its default?</message>
										<tooltip>Resets this section's checkboxes and values to their defaults. Other sections are not touched.</tooltip>
										<actions>
											<li Class="XmlExtensions.Action.ResetSettings">
												<keys/>
											</li>
										</actions>
									</li>
								</settings>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_AdvancedContainer" Abstract="True">
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings/li[tag="CCFB_AdvancedSections"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings</xpath>
						<value>
							<li Class="XmlExtensions.Setting.ToggleableSettings">
								<tag>CCFB_AdvancedSections</tag>
								<key>ToggleSectionSimple</key>
								<caseTrue/>
								<caseFalse/>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_Implant: the one patch template for every implant.
		Parameters:
			defName       - HediffDef defName to patch
			key           - settings key (mod-prefixed to avoid collisions); checkbox key is Toggle{key}
			label         - checkbox label shown in the settings menu
			toggleDefault - default for the enable checkbox (true/false)
			valueDefault  - default bonus in kg
			section       - section tag suffix; rows are added to the SplitColumn tagged CCFB_{section}

		Does two things:
		1. Adds the implant's settings-menu row (checkbox + numeric) to its section. Skipped if any
		   section already shows this key (EPOE/EPOE-Forked and FSF ABE/VBE share keys on purpose).
		2. If the toggle is on, adds <CarryCapacityBonus> (standalone) or <VEF_MassCarryCapacity>
		   (when Vanilla Expanded Framework is active) to the hediff's stage statOffsets, creating
		   stages/li/statOffsets as needed.

		NOTE: deliberately patches the main document directly. An earlier version routed these
		operations through CreateDocument/MergeDocument side documents (the XML Extensions speed
		pattern); the operations all ran without errors but the merged hediff changes never
		reached the parsed defs in RimWorld 1.6. See git history and CLAUDE.md gotchas.
	-->
	<XmlExtensions.PatchDef Name="CCFB_Implant" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.ApplyPatch">
				<patchName>CCFB_ImplantCore</patchName>
				<arguments>
					<li>{defName}</li>
					<li>{key}</li>
					<li>{label}</li>
					<li>{toggleDefault}</li>
					<li>{valueDefault}</li>
					<li>{section}</li>
					<li>PatchOperationAdd</li>
					<li>kg</li>
				</arguments>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_ImplantNativeVEF: for implants whose source mod already grants VEF_MassCarryCapacity
		natively (which is a dead stat in non-VEF games). Same menu row as CCFB_Implant, but the
		hediff patch differs per game:
		- VEF active: REPLACES the author's native VEF_MassCarryCapacity offset with the setting
		  value (PatchOperationAddOrReplace), so the player can override it. Toggle OFF leaves the
		  author's native value untouched.
		- VEF absent: adds our own <CarryCapacityBonus> like CCFB_Implant would (the native VEF
		  offset is dead there, so there is nothing to double-dip).
		Call it with the author's own values as defaults, so out of the box every player gets
		exactly the author's bonus; the folder needs NO VEF gating. NEVER call CCFB_Implant on
		these implants - in VEF games it would ADD on top of the native offset (double-dip).
		Args (in order): defName | settings key | menu label | toggle default | kg default | section tag.
	-->
	<XmlExtensions.PatchDef Name="CCFB_ImplantNativeVEF" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.ApplyPatch">
				<patchName>CCFB_ImplantCore</patchName>
				<arguments>
					<li>{defName}</li>
					<li>{key}</li>
					<li>{label}</li>
					<li>{toggleDefault}</li>
					<li>{valueDefault}</li>
					<li>{section}</li>
					<li>PatchOperationAddOrReplace</li>
					<li>kg</li>
				</arguments>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!-- CCFB_AnimalImplant: like CCFB_Implant, but the value is a percent of the animal's base capacity. -->
	<XmlExtensions.PatchDef Name="CCFB_AnimalImplant" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
				<caseTrue>
					<Operation Class="XmlExtensions.Conditional">
						<xpath>Defs/HediffDef[defName="{defName}"]/modExtensions</xpath>
						<caseFalse>
							<Operation Class="XmlExtensions.PatchOperationAdd">
								<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
								<value>
									<modExtensions/>
								</value>
							</Operation>
						</caseFalse>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="{defName}"]/modExtensions</xpath>
						<value>
							<li Class="Vita.CarryCapacityFromBionics.MissingParts.AnimalCapacityExtension">
								<percent>0</percent>
							</li>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.ApplyPatch">
				<patchName>CCFB_ImplantCore</patchName>
				<arguments>
					<li>{defName}</li>
					<li>{key}</li>
					<li>{label}</li>
					<li>{toggleDefault}</li>
					<li>{valueDefault}</li>
					<li>{section}</li>
					<li>PatchOperationAdd</li>
					<li>pct</li>
				</arguments>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_ImplantCore" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
			<li>vefOperation</li>
			<li>unit</li>
		</parameters>
		<apply>
			<!-- Skip this implant entirely (menu row AND hediff patch, no errors) if its HediffDef
			     does not exist - e.g. the source mod renamed it, or failed to load its defs. -->
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
				<caseTrue>
					<Operation Class="XmlExtensions.IfStatement">
						<condition Class="XmlExtensions.Boolean.Comparison">
							<value1>{valueDefault}</value1>
							<value2>0</value2>
							<relation>sl</relation>
						</condition>
						<caseTrue>
							<Operation Class="XmlExtensions.Conditional">
								<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}_Penalties"]</xpath>
								<caseFalse>
									<Operation Class="XmlExtensions.PatchOperationInsert">
										<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]</xpath>
										<order>Append</order>
										<value>
											<li Class="XmlExtensions.Setting.Group">
												<settings>
													<li Class="XmlExtensions.Setting.Gap">
														<spacing>12</spacing>
													</li>
													<li Class="XmlExtensions.Setting.GapLine"/>
													<li Class="XmlExtensions.Setting.Text">
														<text>Prosthetic penalties</text>
														<font>Medium</font>
														<anchor>Middle</anchor>
														<tooltip>Prosthetics weaker than a natural limb (prosthetic, wooden, peg) lower carry capacity.</tooltip>
													</li>
													<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_SectionToggle">
														<tag>CCFB_{section}_Penalties_All</tag>
														<tooltip>Turns every prosthetic penalty in this section on or off at once.</tooltip>
														<unit>{unit}</unit>
														<keys/>
													</li>
													<li Class="XmlExtensions.Setting.SplitColumn">
														<tag>CCFB_{section}_Penalties</tag>
														<leftCol/>
														<rightCol/>
													</li>
												</settings>
											</li>
										</value>
									</Operation>
								</caseFalse>
							</Operation>
							<Operation Class="XmlExtensions.ApplyPatch">
								<patchName>CCFB_RowMenu</patchName>
								<arguments>
									<li>{key}</li>
									<li>{label}</li>
									<li>false</li>
									<li>{valueDefault}</li>
									<li>{section}</li>
									<li>CCFB_{section}_Penalties</li>
									<li>TogglePenalty</li>
									<li>{unit}</li>
								</arguments>
							</Operation>
							<Operation Class="XmlExtensions.OptionalPatch">
								<modId>Vita.CarryCapacityFromBionics</modId>
								<key>ToggleSectionSimple</key>
								<defaultValue>true</defaultValue>
								<caseTrue>
									<Operation Class="XmlExtensions.OptionalPatch">
										<modId>Vita.CarryCapacityFromBionics</modId>
										<key>SimplePenalties</key>
										<defaultValue>false</defaultValue>
										<caseTrue>
											<Operation Class="XmlExtensions.ApplyPatch">
												<patchName>CCFB_ModeOffset</patchName>
												<arguments>
													<li>{defName}</li>
													<li>{key}</li>
													<li>{label}</li>
													<li>{toggleDefault}</li>
													<li>{valueDefault}</li>
													<li>{section}</li>
													<li>{vefOperation}</li>
													<li>TogglePenalty</li>
													<li>{unit}</li>
												</arguments>
											</Operation>
										</caseTrue>
									</Operation>
								</caseTrue>
								<caseFalse>
									<Operation Class="XmlExtensions.ApplyPatch">
										<patchName>CCFB_ModeOffset</patchName>
										<arguments>
											<li>{defName}</li>
											<li>{key}</li>
											<li>{label}</li>
											<li>false</li>
											<li>{valueDefault}</li>
											<li>{section}</li>
											<li>{vefOperation}</li>
											<li>TogglePenalty</li>
											<li>{unit}</li>
										</arguments>
									</Operation>
								</caseFalse>
							</Operation>
						</caseTrue>
						<caseFalse>
							<Operation Class="XmlExtensions.ApplyPatch">
								<patchName>CCFB_RowMenu</patchName>
								<arguments>
									<li>{key}</li>
									<li>{label}</li>
									<li>{toggleDefault}</li>
									<li>{valueDefault}</li>
									<li>{section}</li>
									<li>CCFB_{section}</li>
									<li>Toggle</li>
									<li>{unit}</li>
								</arguments>
							</Operation>
							<Operation Class="XmlExtensions.ApplyPatch">
								<patchName>CCFB_ModeOffset</patchName>
								<arguments>
									<li>{defName}</li>
									<li>{key}</li>
									<li>{label}</li>
									<li>{toggleDefault}</li>
									<li>{valueDefault}</li>
									<li>{section}</li>
									<li>{vefOperation}</li>
									<li>Toggle</li>
									<li>{unit}</li>
								</arguments>
							</Operation>
						</caseFalse>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_RowMenu" Abstract="True">
		<parameters>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
			<li>target</li>
			<li>togglePrefix</li>
			<li>unit</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="{togglePrefix}{key}"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="{target}"]/leftCol</xpath>
						<value>
							<!-- Checkbox first, then the name. CheckboxLabeled pins the box to the RIGHT
							     edge of its rect, so a 24px-wide label-less checkbox puts the box flush
							     left; the name is a separate Text with the full remaining width (long
							     names wrap instead of truncating). Trade-off: only the box is clickable. -->
							<li Class="XmlExtensions.Setting.SplitColumn">
								<width>24</width>
								<gapSize>6</gapSize>
								<anchor>Middle</anchor>
								<leftCol>
									<li Class="XmlExtensions.Setting.Checkbox">
										<label></label>
										<key>{togglePrefix}{key}</key>
										<defaultValue>{toggleDefault}</defaultValue>
									</li>
								</leftCol>
								<rightCol>
									<li Class="XmlExtensions.Setting.Text">
										<text>{label}</text>
									</li>
								</rightCol>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.ApplyPatch">
						<patchName>CCFB_RowValue_{unit}</patchName>
						<arguments>
							<li>{key}</li>
							<li>{valueDefault}</li>
							<li>{target}</li>
							<li>{togglePrefix}</li>
						</arguments>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSection{section}"]/actions/li/keys</xpath>
						<value>
							<li>{togglePrefix}{key}</li>
							<li>{key}</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="{target}_All"]/keys</xpath>
						<value>
							<li>{togglePrefix}{key}</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_SimpleExamples"]/rows</xpath>
						<value>
							<li>
								<key>{key}</key>
								<label>{label}</label>
								<section>{section}</section>
								<value>{valueDefault}</value>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!-- Right half of a row: kg box or percent box (animal rows). -->
	<XmlExtensions.PatchDef Name="CCFB_RowValue_kg" Abstract="True">
		<parameters>
			<li>key</li>
			<li>valueDefault</li>
			<li>target</li>
			<li>togglePrefix</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="{target}"]/rightCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.ToggleableSettings">
						<key>{togglePrefix}{key}</key>
						<caseTrue>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<split>0.79</split>
								<anchor>Middle</anchor>
								<leftCol/>
								<rightCol>
									<li Class="XmlExtensions.Setting.Numeric">
										<decimals>2</decimals>
										<key>{key}</key>
										<defaultValue>{valueDefault}</defaultValue>
										<padRight>25</padRight>
									</li>
								</rightCol>
							</li>
						</caseTrue>
						<caseFalse>
							<li Class="XmlExtensions.Setting.Text">
								<text>Disabled</text>
								<padRight>25</padRight>
								<anchor>Right</anchor>
							</li>
						</caseFalse>
					</li>
				</value>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_RowValue_pct" Abstract="True">
		<parameters>
			<li>key</li>
			<li>valueDefault</li>
			<li>target</li>
			<li>togglePrefix</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationAdd">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="{target}"]/rightCol</xpath>
				<value>
					<li Class="XmlExtensions.Setting.ToggleableSettings">
						<key>{togglePrefix}{key}</key>
						<caseTrue>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<split>0.79</split>
								<anchor>Middle</anchor>
								<leftCol/>
								<rightCol>
									<li Class="Vita.CarryCapacityFromBionics.MissingParts.Setting_AnimalTip">
										<valueKey>{key}</valueKey>
										<defaultValue>{valueDefault}</defaultValue>
									</li>
									<li Class="XmlExtensions.Setting.Numeric">
										<decimals>2</decimals>
										<percent>true</percent>
										<key>{key}</key>
										<defaultValue>{valueDefault}</defaultValue>
									</li>
								</rightCol>
							</li>
						</caseTrue>
						<caseFalse>
							<li Class="XmlExtensions.Setting.Text">
								<text>Disabled</text>
								<padRight>25</padRight>
								<anchor>Right</anchor>
							</li>
						</caseFalse>
					</li>
				</value>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_ModeOffset" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
			<li>vefOperation</li>
			<li>togglePrefix</li>
			<li>unit</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.OptionalPatch">
				<modId>Vita.CarryCapacityFromBionics</modId>
				<key>ToggleSectionSimple</key>
				<defaultValue>true</defaultValue>
				<caseTrue>
					<Operation Class="XmlExtensions.IfStatement">
						<condition Class="XmlExtensions.Boolean.Comparison">
							<value1>{valueDefault}</value1>
							<value2>0</value2>
							<relation>neq</relation>
						</condition>
						<caseTrue>
							<Operation Class="XmlExtensions.ApplyPatch">
								<patchName>CCFB_ScaledOffset</patchName>
								<arguments>
									<li>{defName}</li>
									<li>{valueDefault}</li>
									<li>{vefOperation}</li>
									<li>{unit}</li>
								</arguments>
							</Operation>
						</caseTrue>
					</Operation>
				</caseTrue>
				<caseFalse>
					<Operation Class="XmlExtensions.OptionalPatch">
						<modId>Vita.CarryCapacityFromBionics</modId>
						<key>{togglePrefix}{key}</key>
						<defaultValue>{toggleDefault}</defaultValue>
						<caseTrue>
							<Operation Class="XmlExtensions.UseSetting">
								<modId>Vita.CarryCapacityFromBionics</modId>
								<key>{key}</key>
								<defaultValue>{valueDefault}</defaultValue>
								<apply>
									<Operation Class="XmlExtensions.ApplyPatch">
										<patchName>CCFB_AddOffset_{unit}</patchName>
										<arguments>
											<li>{defName}</li>
											<li>{{key}}</li>
											<li>{vefOperation}</li>
										</arguments>
									</Operation>
								</apply>
							</Operation>
						</caseTrue>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_AddOffset_kg" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>value</li>
			<li>vefOperation</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]/stages</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
						<value>
							<stages>
								<li/>
							</stages>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="{defName}"]/stages/li</xpath>
						<value>
							<statOffsets/>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>OskarPotocki.VanillaFactionsExpanded.Core</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.{vefOperation}">
						<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
						<value>
							<VEF_MassCarryCapacity>{value}</VEF_MassCarryCapacity>
						</value>
					</Operation>
				</caseTrue>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
						<value>
							<CarryCapacityBonus>{value}</CarryCapacityBonus>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!-- Animal rows: the percent is stored on the hediff and applied by StatPart_AnimalImplants. -->
	<XmlExtensions.PatchDef Name="CCFB_AddOffset_pct" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>value</li>
			<li>vefOperation</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationReplace">
				<xpath>Defs/HediffDef[defName="{defName}"]/modExtensions/li[@Class="Vita.CarryCapacityFromBionics.MissingParts.AnimalCapacityExtension"]/percent</xpath>
				<value>
					<percent>{value}</percent>
				</value>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<XmlExtensions.PatchDef Name="CCFB_ScaledOffset" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>valueDefault</li>
			<li>vefOperation</li>
			<li>unit</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.UseSetting">
				<modId>Vita.CarryCapacityFromBionics</modId>
				<key>SimpleScale</key>
				<defaultValue>100</defaultValue>
				<apply>
					<Operation Class="XmlExtensions.CreateVariable">
						<storeIn>CCFB_Scaled</storeIn>
						<value>{valueDefault}</value>
						<value2>{SimpleScale}</value2>
						<operation>*</operation>
						<apply>
							<Operation Class="XmlExtensions.CreateVariable">
								<storeIn>CCFB_Final</storeIn>
								<value>{CCFB_Scaled}</value>
								<value2>100</value2>
								<operation>/</operation>
								<apply>
									<Operation Class="XmlExtensions.ApplyPatch">
										<patchName>CCFB_AddOffset_{unit}</patchName>
										<arguments>
											<li>{defName}</li>
											<li>{CCFB_Final}</li>
											<li>{vefOperation}</li>
										</arguments>
									</Operation>
								</apply>
							</Operation>
						</apply>
					</Operation>
				</apply>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_PartRow: settings-menu row ONLY (no hediff patch) - used by the missing-body-part
		penalty feature, whose values are read by C# (CarryCapacityMissingParts.dll) instead of
		feeding XML patches (all missing parts share one MissingBodyPart hediff def, which is why
		the feature is C#-only). Same row layout as CCFB_Implant's menu half.
		Args (in order): settings key | menu label | toggle default | kg default | section tag | tooltip.
		Reset keys register with the Core section's button (the rows live inside Core Implants).
	-->
	<XmlExtensions.PatchDef Name="CCFB_PartRow" Abstract="True">
		<parameters>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
			<li>tooltip</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="TogglePenalty{key}"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/leftCol</xpath>
						<value>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<width>24</width>
								<gapSize>6</gapSize>
								<anchor>Middle</anchor>
								<leftCol>
									<li Class="XmlExtensions.Setting.Checkbox">
										<label></label>
										<key>TogglePenalty{key}</key>
										<defaultValue>{toggleDefault}</defaultValue>
									</li>
								</leftCol>
								<rightCol>
									<li Class="XmlExtensions.Setting.Text">
										<text>{label}</text>
										<tooltip>{tooltip}</tooltip>
									</li>
								</rightCol>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/rightCol</xpath>
						<value>
							<li Class="XmlExtensions.Setting.ToggleableSettings">
								<key>TogglePenalty{key}</key>
								<caseTrue>
									<li Class="XmlExtensions.Setting.SplitColumn">
										<split>0.79</split>
										<anchor>Middle</anchor>
										<leftCol>
											<li Class="XmlExtensions.Setting.Text">
												<text>Reduce carry capacity by</text>
												<anchor>Right</anchor>
											</li>
										</leftCol>
										<rightCol>
											<li Class="XmlExtensions.Setting.Numeric">
												<decimals>1</decimals>
												<percent>true</percent>
												<key>{key}</key>
												<defaultValue>{valueDefault}</defaultValue>
											</li>
										</rightCol>
									</li>
								</caseTrue>
								<caseFalse>
									<li Class="XmlExtensions.Setting.Text">
										<text>Disabled</text>
										<padRight>25</padRight>
										<anchor>Right</anchor>
									</li>
								</caseFalse>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}_All"]/keys</xpath>
						<value>
							<li>TogglePenalty{key}</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSectionCore"]/actions/li/keys</xpath>
						<value>
							<li>TogglePenalty{key}</li>
							<li>{key}</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

</Defs>
