<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--
		CCFB_Section: creates one labeled section in the settings menu - a header row with the
		section's MASTER CHECKBOX (key ToggleSection{section}) next to the title, and a
		collapsible body (ToggleableSettings): master unticked = only the title shows, and
		CCFB_Implant/CCFB_ImplantNativeVEF skip every hediff patch in the section (the master
		gates them via OptionalPatch). The collapse is live; the patches need a restart as usual.
		Args (in order): section label | section tag | master checkbox default (true/false).
		Idempotent: if a SplitColumn tagged CCFB_{section} already exists, does nothing, so any
		patch file may call it for the section it needs and patch-file order does not matter.
	-->
	<XmlExtensions.PatchDef Name="CCFB_Section" Abstract="True">
		<parameters>
			<li>sectionLabel</li>
			<li>section</li>
			<li>masterDefault</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings</xpath>
						<value>
							<li Class="XmlExtensions.Setting.Gap">
								<spacing>24</spacing>
							</li>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<width>24</width>
								<gapSize>6</gapSize>
								<anchor>Middle</anchor>
								<leftCol>
									<li Class="XmlExtensions.Setting.Checkbox">
										<label></label>
										<key>ToggleSection{section}</key>
										<defaultValue>{masterDefault}</defaultValue>
										<tooltip>Enable or disable this entire section. Disabled: the section collapses and none of its rows apply (restart required for the bonuses themselves).</tooltip>
									</li>
								</leftCol>
								<rightCol>
									<li Class="XmlExtensions.Setting.Text">
										<text>{sectionLabel}</text>
										<font>Medium</font>
										<anchor>Middle</anchor>
									</li>
								</rightCol>
							</li>
							<li Class="XmlExtensions.Setting.GapLine"/>
							<li Class="XmlExtensions.Setting.ToggleableSettings">
								<key>ToggleSection{section}</key>
								<caseTrue>
									<li Class="XmlExtensions.Setting.Section">
										<settings>
											<li Class="XmlExtensions.Setting.SplitColumn">
												<tag>CCFB_{section}</tag>
												<leftCol/>
												<rightCol/>
											</li>
											<li Class="XmlExtensions.Setting.Gap">
												<spacing>12</spacing>
											</li>
											<!-- Per-section reset. Every row PatchDef registers its keys into this
											     button's ResetSettings list as it adds its row, so the button only
											     ever touches THIS section's settings. -->
											<li Class="XmlExtensions.Setting.Button">
												<label>Reset this section</label>
												<key>ToggleSection{section}</key>
												<height>24</height>
												<confirm>true</confirm>
												<message>Reset every setting in this section to its default?</message>
												<tooltip>Resets this section's checkboxes and values to their defaults. Other sections are not touched.</tooltip>
												<actions>
													<li Class="XmlExtensions.Action.ResetSettings">
														<keys>
															<li>ToggleSection{section}</li>
														</keys>
													</li>
												</actions>
											</li>
										</settings>
									</li>
								</caseTrue>
								<caseFalse/>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_Implant: the one patch template for every implant.
		Parameters:
			defName       - HediffDef defName to patch
			key           - settings key (mod-prefixed to avoid collisions); checkbox key is Toggle{key}
			label         - checkbox label shown in the settings menu
			toggleDefault - default for the enable checkbox (true/false)
			valueDefault  - default bonus in kg
			section       - section tag suffix; rows are added to the SplitColumn tagged CCFB_{section}

		Does two things:
		1. Adds the implant's settings-menu row (checkbox + numeric) to its section. Skipped if any
		   section already shows this key (EPOE/EPOE-Forked and FSF ABE/VBE share keys on purpose).
		2. If the toggle is on, adds <CarryCapacityBonus> (standalone) or <VEF_MassCarryCapacity>
		   (when Vanilla Expanded Framework is active) to the hediff's stage statOffsets, creating
		   stages/li/statOffsets as needed.

		NOTE: deliberately patches the main document directly. An earlier version routed these
		operations through CreateDocument/MergeDocument side documents (the XML Extensions speed
		pattern); the operations all ran without errors but the merged hediff changes never
		reached the parsed defs in RimWorld 1.6. See git history and CLAUDE.md gotchas.
	-->
	<XmlExtensions.PatchDef Name="CCFB_Implant" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
		</parameters>
		<apply>

			<!-- Skip this implant entirely (menu row AND hediff patch, no errors) if its HediffDef
			     does not exist - e.g. the source mod renamed it, or failed to load its defs. -->
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
				<caseTrue>
				<!-- 1. Settings menu rows -->
				<Operation Class="XmlExtensions.Conditional">
					<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="Toggle{key}"]</xpath>
					<caseFalse>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/leftCol</xpath>
							<value>
								<!-- Checkbox first, then the name. CheckboxLabeled pins the box to the RIGHT
								     edge of its rect, so a 24px-wide label-less checkbox puts the box flush
								     left; the name is a separate Text with the full remaining width (long
								     names wrap instead of truncating). Trade-off: only the box is clickable. -->
								<li Class="XmlExtensions.Setting.SplitColumn">
									<width>24</width>
									<gapSize>6</gapSize>
									<anchor>Middle</anchor>
									<leftCol>
										<li Class="XmlExtensions.Setting.Checkbox">
											<label></label>
											<key>Toggle{key}</key>
											<defaultValue>{toggleDefault}</defaultValue>
										</li>
									</leftCol>
									<rightCol>
										<li Class="XmlExtensions.Setting.Text">
											<text>{label}</text>
										</li>
									</rightCol>
								</li>
							</value>
						</Operation>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/rightCol</xpath>
							<value>
								<li Class="XmlExtensions.Setting.ToggleableSettings">
									<key>Toggle{key}</key>
									<caseTrue>
										<li Class="Vita.CarryCapacityFromBionics.UI.DualUnitNumeric">
											<key>{key}</key>
											<label>Extra carry capacity</label>
											<defaultValue>{valueDefault}</defaultValue>
											<storedUnit>Kg</storedUnit>
										</li>
									</caseTrue>
									<caseFalse>
										<li Class="XmlExtensions.Setting.Text">
											<text>Disabled</text>
											<anchor>Right</anchor>
										</li>
									</caseFalse>
								</li>
							</value>
						</Operation>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSection{section}"]/actions/li/keys</xpath>
							<value>
								<li>Toggle{key}</li>
								<li>{key}</li>
							</value>
						</Operation>
					</caseFalse>
				</Operation>

				<!-- 2. Hediff statOffsets patch. The section's master checkbox gates the whole
				     thing: master off = no bonus from this section, individual toggles ignored. -->
				<Operation Class="XmlExtensions.OptionalPatch">
					<modId>Vita.CarryCapacityFromBionics</modId>
					<key>ToggleSection{section}</key>
					<defaultValue>true</defaultValue>
					<caseTrue>
				<Operation Class="XmlExtensions.OptionalPatch">
					<modId>Vita.CarryCapacityFromBionics</modId>
					<key>Toggle{key}</key>
					<defaultValue>{toggleDefault}</defaultValue>
					<caseTrue>
						<Operation Class="XmlExtensions.UseSetting">
							<modId>Vita.CarryCapacityFromBionics</modId>
							<key>{key}</key>
							<defaultValue>{valueDefault}</defaultValue>
							<apply>
								<Operation Class="XmlExtensions.Conditional">
									<xpath>Defs/HediffDef[defName="{defName}"]/stages</xpath>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
											<value>
												<stages>
													<li/>
												</stages>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
								<Operation Class="XmlExtensions.Conditional">
									<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li</xpath>
											<value>
												<statOffsets/>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
								<Operation Class="XmlExtensions.FindMod">
									<mods>
										<li>OskarPotocki.VanillaFactionsExpanded.Core</li>
									</mods>
									<packageId>true</packageId>
									<caseTrue>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
											<value>
												<VEF_MassCarryCapacity>{{key}}</VEF_MassCarryCapacity>
											</value>
										</Operation>
									</caseTrue>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
											<value>
												<CarryCapacityBonus>{{key}}</CarryCapacityBonus>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
							</apply>
						</Operation>
					</caseTrue>
				</Operation>
					</caseTrue>
				</Operation>
				</caseTrue>
			</Operation>

		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_ImplantNativeVEF: for implants whose source mod already grants VEF_MassCarryCapacity
		natively (which is a dead stat in non-VEF games). Same menu row as CCFB_Implant, but the
		hediff patch differs per game:
		- VEF active: REPLACES the author's native VEF_MassCarryCapacity offset with the setting
		  value (PatchOperationAddOrReplace), so the player can override it. Toggle OFF leaves the
		  author's native value untouched.
		- VEF absent: adds our own <CarryCapacityBonus> like CCFB_Implant would (the native VEF
		  offset is dead there, so there is nothing to double-dip).
		Call it with the author's own values as defaults, so out of the box every player gets
		exactly the author's bonus; the folder needs NO VEF gating. NEVER call CCFB_Implant on
		these implants - in VEF games it would ADD on top of the native offset (double-dip).
		Args (in order): defName | settings key | menu label | toggle default | kg default | section tag.
	-->
	<XmlExtensions.PatchDef Name="CCFB_ImplantNativeVEF" Abstract="True">
		<parameters>
			<li>defName</li>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
		</parameters>
		<apply>

			<!-- Skip this implant entirely (menu row AND hediff patch, no errors) if its HediffDef
			     does not exist - e.g. the source mod renamed it, or failed to load its defs. -->
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
				<caseTrue>
				<!-- 1. Settings menu rows -->
				<Operation Class="XmlExtensions.Conditional">
					<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="Toggle{key}"]</xpath>
					<caseFalse>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/leftCol</xpath>
							<value>
								<!-- Checkbox first, then the name. CheckboxLabeled pins the box to the RIGHT
								     edge of its rect, so a 24px-wide label-less checkbox puts the box flush
								     left; the name is a separate Text with the full remaining width (long
								     names wrap instead of truncating). Trade-off: only the box is clickable. -->
								<li Class="XmlExtensions.Setting.SplitColumn">
									<width>24</width>
									<gapSize>6</gapSize>
									<anchor>Middle</anchor>
									<leftCol>
										<li Class="XmlExtensions.Setting.Checkbox">
											<label></label>
											<key>Toggle{key}</key>
											<defaultValue>{toggleDefault}</defaultValue>
										</li>
									</leftCol>
									<rightCol>
										<li Class="XmlExtensions.Setting.Text">
											<text>{label}</text>
										</li>
									</rightCol>
								</li>
							</value>
						</Operation>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/rightCol</xpath>
							<value>
								<li Class="XmlExtensions.Setting.ToggleableSettings">
									<key>Toggle{key}</key>
									<caseTrue>
										<li Class="Vita.CarryCapacityFromBionics.UI.DualUnitNumeric">
											<key>{key}</key>
											<label>Extra carry capacity</label>
											<defaultValue>{valueDefault}</defaultValue>
											<storedUnit>Kg</storedUnit>
										</li>
									</caseTrue>
									<caseFalse>
										<li Class="XmlExtensions.Setting.Text">
											<text>Disabled</text>
											<anchor>Right</anchor>
										</li>
									</caseFalse>
								</li>
							</value>
						</Operation>
						<Operation Class="XmlExtensions.PatchOperationAdd">
							<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSection{section}"]/actions/li/keys</xpath>
							<value>
								<li>Toggle{key}</li>
								<li>{key}</li>
							</value>
						</Operation>
					</caseFalse>
				</Operation>

				<!-- 2. Hediff statOffsets patch: VEF -> override the native offset, no VEF -> add ours.
				     The section's master checkbox gates the whole thing, like in CCFB_Implant. -->
				<Operation Class="XmlExtensions.OptionalPatch">
					<modId>Vita.CarryCapacityFromBionics</modId>
					<key>ToggleSection{section}</key>
					<defaultValue>true</defaultValue>
					<caseTrue>
				<Operation Class="XmlExtensions.OptionalPatch">
					<modId>Vita.CarryCapacityFromBionics</modId>
					<key>Toggle{key}</key>
					<defaultValue>{toggleDefault}</defaultValue>
					<caseTrue>
						<Operation Class="XmlExtensions.UseSetting">
							<modId>Vita.CarryCapacityFromBionics</modId>
							<key>{key}</key>
							<defaultValue>{valueDefault}</defaultValue>
							<apply>
								<Operation Class="XmlExtensions.Conditional">
									<xpath>Defs/HediffDef[defName="{defName}"]/stages</xpath>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]</xpath>
											<value>
												<stages>
													<li/>
												</stages>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
								<Operation Class="XmlExtensions.Conditional">
									<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li</xpath>
											<value>
												<statOffsets/>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
								<Operation Class="XmlExtensions.FindMod">
									<mods>
										<li>OskarPotocki.VanillaFactionsExpanded.Core</li>
									</mods>
									<packageId>true</packageId>
									<caseTrue>
										<Operation Class="XmlExtensions.PatchOperationAddOrReplace">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
											<value>
												<VEF_MassCarryCapacity>{{key}}</VEF_MassCarryCapacity>
											</value>
										</Operation>
									</caseTrue>
									<caseFalse>
										<Operation Class="XmlExtensions.PatchOperationAdd">
											<xpath>Defs/HediffDef[defName="{defName}"]/stages/li/statOffsets</xpath>
											<value>
												<CarryCapacityBonus>{{key}}</CarryCapacityBonus>
											</value>
										</Operation>
									</caseFalse>
								</Operation>
							</apply>
						</Operation>
					</caseTrue>
				</Operation>
					</caseTrue>
				</Operation>
				</caseTrue>
			</Operation>

		</apply>
	</XmlExtensions.PatchDef>

	<!--
		CCFB_PartRow: settings-menu row ONLY (no hediff patch) - used by the missing-body-part
		penalty feature, whose values are read by C# (CarryCapacityMissingParts.dll) instead of
		feeding XML patches (all missing parts share one MissingBodyPart hediff def, which is why
		the feature is C#-only). Same row layout as CCFB_Implant's menu half. The value control
		is DualUnitNumeric (CarryCapacityMissingParts.dll): percent stored, kg derived, both
		editable - editing either field updates the other live.
		Args (in order): settings key | menu label | toggle default | percent default | section tag | tooltip.
	-->
	<XmlExtensions.PatchDef Name="CCFB_PartRow" Abstract="True">
		<parameters>
			<li>key</li>
			<li>label</li>
			<li>toggleDefault</li>
			<li>valueDefault</li>
			<li>section</li>
			<li>tooltip</li>
		</parameters>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//leftCol/li[key="Toggle{key}"]</xpath>
				<caseFalse>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/leftCol</xpath>
						<value>
							<li Class="XmlExtensions.Setting.SplitColumn">
								<width>24</width>
								<gapSize>6</gapSize>
								<anchor>Middle</anchor>
								<leftCol>
									<li Class="XmlExtensions.Setting.Checkbox">
										<label></label>
										<key>Toggle{key}</key>
										<defaultValue>{toggleDefault}</defaultValue>
									</li>
								</leftCol>
								<rightCol>
									<li Class="XmlExtensions.Setting.Text">
										<text>{label}</text>
										<tooltip>{tooltip}</tooltip>
									</li>
								</rightCol>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[tag="CCFB_{section}"]/rightCol</xpath>
						<value>
							<li Class="XmlExtensions.Setting.ToggleableSettings">
								<key>Toggle{key}</key>
								<caseTrue>
									<li Class="Vita.CarryCapacityFromBionics.UI.DualUnitNumeric">
										<key>{key}</key>
										<label>Reduce carry capacity by</label>
										<defaultValue>{valueDefault}</defaultValue>
										<storedUnit>Percent</storedUnit>
									</li>
								</caseTrue>
								<caseFalse>
									<li Class="XmlExtensions.Setting.Text">
										<text>Disabled</text>
										<anchor>Right</anchor>
									</li>
								</caseFalse>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationAdd">
						<xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Vita.CarryCapacityFromBionics"]/settings//li[@Class="XmlExtensions.Setting.Button"][key="ToggleSection{section}"]/actions/li/keys</xpath>
						<value>
							<li>Toggle{key}</li>
							<li>{key}</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
		</apply>
	</XmlExtensions.PatchDef>

</Defs>
