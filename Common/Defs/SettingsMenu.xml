<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--
		Skeleton settings menu. Sections and per-implant rows are injected at patch time by the
		CCFB_Section / CCFB_Implant PatchDefs (see PatchDefs.xml), called from each loaded
		source folder's patch file. Only folders for active mods/DLC load, so the menu only ever
		shows content that is actually present - no MayRequire gating needed.
	-->
	<XmlExtensions.SettingsMenuDef>
		<modId>Vita.CarryCapacityFromBionics</modId>
		<label>Carry Capacity from Bionics</label>
		<defaultSpacing>3</defaultSpacing>
		<settings>
			<!-- Red via inline rich text, not XE's <color> field: that field only exists in
			     XML Extensions' 1.6 assembly and throws an XML error on 1.5. -->
			<li Class="XmlExtensions.Setting.Text">
				<text>&lt;color=red&gt;Game must be restarted for any changes to take effect!&lt;/color&gt;</text>
				<anchor>Middle</anchor>
			</li>
		</settings>
	</XmlExtensions.SettingsMenuDef>
</Defs>
