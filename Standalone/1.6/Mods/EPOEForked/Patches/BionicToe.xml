<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>Vita.CarryCapacityFromBionics</modId>
		<key>ToggleEPOEBionicToe</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<Operation Class="XmlExtensions.UseSetting">
				<modId>Vita.CarryCapacityFromBionics</modId>
				<key>EPOEBionicToe</key>
				<defaultValue>1</defaultValue>
				<apply>
					<Operation Class="PatchOperationConditional">
						<xpath>Defs/HediffDef[defName="BionicToe"]/stages</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="BionicToe"]</xpath>
							<value>
								<stages>
									<li/>
								</stages>
							</value>
						</nomatch>
					</Operation>
					<Operation Class="PatchOperationConditional">
						<xpath>Defs/HediffDef[defName="BionicToe"]/stages/li/statOffsets</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="BionicToe"]/stages/li</xpath>
							<value>
								<statOffsets/>
							</value>
						</nomatch>
					</Operation>
					<Operation Class="PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="BionicToe"]/stages/li/statOffsets</xpath>
						<value>
							<CarryCapacityBonus>{EPOEBionicToe}</CarryCapacityBonus>
						</value>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>
</Patch>