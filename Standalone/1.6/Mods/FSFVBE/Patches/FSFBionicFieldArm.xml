<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="XmlExtensions.OptionalPatch">
			<modId>Vita.CarryCapacityFromBionics</modId>
			<key>ToggleFSFBionicFieldArm</key>
			<defaultValue>true</defaultValue>
			<caseTrue>
				<Operation Class="XmlExtensions.UseSetting">
					<modId>Vita.CarryCapacityFromBionics</modId>
					<key>FSFBionicFieldArm</key>
					<defaultValue>12.5</defaultValue>
					<apply>
					<Operation Class="PatchOperationConditional">
						<xpath>Defs/HediffDef[defName="FSFBionicFieldArm"]/stages</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="FSFBionicFieldArm"]</xpath>
							<value>
								<stages>
									<li/>
								</stages>
							</value>
						</nomatch>
					</Operation>
					<Operation Class="PatchOperationConditional">
						<xpath>Defs/HediffDef[defName="FSFBionicFieldArm"]/stages/li/statOffsets</xpath>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/HediffDef[defName="FSFBionicFieldArm"]/stages/li</xpath>
							<value>
								<statOffsets/>
							</value>
						</nomatch>
					</Operation>
					<Operation Class="PatchOperationAdd">
						<xpath>Defs/HediffDef[defName="FSFBionicFieldArm"]/stages/li/statOffsets</xpath>
						<value>
							<CarryCapacityBonus>{FSFBionicFieldArm}</CarryCapacityBonus>
						</value>
					</Operation>
				</apply>
				</Operation>
			</caseTrue>
		</match>
	</Operation>
</Patch>