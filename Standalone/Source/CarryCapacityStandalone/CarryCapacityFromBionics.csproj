<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone (non-VEF) stat machinery: CarryCapacityBonus StatWorker + the Harmony
       transpiler on MassUtility.Capacity. Only loaded when VEF is absent (LoadFolders gating).
       Build with: dotnet build -c Release
       (needs no Visual Studio; reference assemblies come from the NuGet package). -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>CarryCapacityFromBionics</RootNamespace>
    <AssemblyName>CarryCapacityFromBionics</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
